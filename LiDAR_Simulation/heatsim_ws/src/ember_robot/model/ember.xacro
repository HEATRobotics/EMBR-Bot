<?xml version="1.0"?>
<!-- Ember_Robot_Sim 1.0                                 -->
<!-- ################################################    -->
<!-- URDF DESCRIPTION OF THE EMBER BOT                   -->
<!-- Author: Maison Gulyas | (250) 258 - 1736            -->
<!-- ################################################    -->
<!-- This URDF will be four a quadropod Robot with a LiDAR 
    attatched to the front, this LiDAR can be used in both
    2D and 3D modes.

    *Note xacros are always in SI*
-->
<!-- ################################################    -->
<!-- Robot Part Names: 
Tracks:
    * trackL1 (Left front track)    <Rectangular>
    * trackL2 (Left back track)     <Rectangular>
    * trackR1 (Right front track)   <Rectangular>
    * trackR2 (Right back track)    <Rectangular>
Body:
    * body <Rectangular>
LiDAR:
    * LiDAR <Cylindar>
-->
<!-- Shape Geometry  
Rectangle: (for track add "track_" to fron, so for body add "body_" etc)
    * rect_length
    * rect_width
    * rect_height
    * rect_mass
Cylindar
    * LiDAR_radius 
    * LiDAR_length
    * LiDAR_mass
 -->

<!-- ################################################    -->
<!-- TODO: When completed -->
<!-- <robot name="ember_bot" xmlns:xacro="http://www.ros.org/wiki/xacro"> -->

<!-- ################################################    -->
<!--            Geometry & Constants                     -->
<!--            MARK: G & C                              -->
<!-- ################################################    -->

<!-- Track Dimensions -->
<xacro:property name="tw" value="0.1"/>   <!-- Track width -->
<xacro:property name="th" value="0.05"/>  <!-- Track height -->
<xacro:property name="tl" value="0.3"/>   <!-- Track length -->

<!-- Body Dimensions -->
<xacro:property name="bw" value="0.3"/>  <!-- Body width -->
<xacro:property name="bh" value="0.1"/>  <!-- Body height -->
<xacro:property name="bl" value="0.3"/>  <!-- Body length -->

<!-- LiDAR Dimensions -->
<xacro:property name="lr" value="0.15"/> <!-- LiDAR Radius -->
<xacro:property name="ll" value="0.1"/>  <!-- LiDAR Length -->

<!-- TODO: Set Distances -->
<!-- Distances Between Certain Centres -->
<xacro:property name="s1" value="${b/2 + r}"/>
<xacro:property name="s2" value="${r*2}"/>
<xacro:property name="s3" value="${r*2}"/>
<xacro:property name="s4" value="${c/2 + d/2}"/>

<!-- ################################################    -->
<!--                  Mass & Inertia                     -->
<!--                  MARK: M & I                        -->
<!-- ################################################    -->

<!-- Densities -->
<xacro:property name="body_desnity" value="2710.0"/>  <!-- body -->
<xacro:property name="track_desnity" value="2710.0"/>  <!-- track -->\

 <!-- LiDAR density is not set as it would affect the spin of
 the LiDAR if we were to set it. That being said the spin is
 not simulated so we do not need to worry about it.-->

<!-- Masses -->
<xacro:property name="body_mass" value="${body_desnity*bl*bh*bw}"/>
<xacro:property name="track_mass" value="${track_desnity*tl*th*tw}"/>

<!-- Body inertia -->
<xacro:property name="Ix_body" value="${(1.0/12.0)*body_mass*(bh*bh + bw*bw)}"/>
<xacro:property name="Iy_body" value="${(1.0/12.0)*body_mass*(bl*bl + bh*bh)}"/>
<xacro:property name="Iz_body" value="${(1.0/12.0)*body_mass*(bl*bl + bw*bw)}"/>

<!-- Track inertia -->
<xacro:property name="Ix_track" value="${(1.0/12.0)*mT*(tw*tw + th*th)}"/>
<xacro:property name="Iy_track" value="${(1.0/12.0)*mT*(tl*tl + th*th)}"/>
<xacro:property name="Iz_track" value="${(1.0/12.0)*mT*(tl*tl + tw*tw)}"/>

<!-- Inertia macros -->

