<?xml version="1.0"?>
<!-- Ember_Robot_Sim 1.0                                 -->
<!-- ################################################    -->
<!-- URDF DESCRIPTION OF THE EMBER BOT                   -->
<!-- Author: Maison Gulyas | (250) 258 - 1736            -->
<!-- ################################################    -->
<!-- This URDF will be four a quadropod Robot with a LiDAR 
    attatched to the front, this LiDAR can be used in both
    2D and 3D modes.

    *Note xacros are always in SI*
-->
<!-- ################################################    -->
<!-- 
Orientation:
    x -> Forward
    y -> Left
    z -> Up
-->
<!-- Robot Part Names: 
Tracks:
    * trackL1 (Left front track)    <Rectangular>
    * trackL2 (Left back track)     <Rectangular>
    * trackR1 (Right front track)   <Rectangular>
    * trackR2 (Right back track)    <Rectangular>
Body:
    * body <Rectangular>
LiDAR:
    * LiDAR <Cylindar>
-->
<!-- Shape Geometry  
Rectangle: (for track add "track_" to fron, so for body add "body_" etc)
    * rect_length
    * rect_width
    * rect_height
    * rect_mass
Cylindar
    * LiDAR_radius 
    * LiDAR_length
    * LiDAR_mass
 -->

<!-- ################################################    -->

<robot name="ember_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">>

<!-- ################################################    -->
<!--            Geometry & Constants                     -->
<!--            MARK: G & C                              -->
<!-- ################################################    -->

<!-- Track Dimensions -->
<xacro:property name="tl" value="0.30"/>   <!-- track length (X) -->
<xacro:property name="tw" value="0.10"/>   <!-- track width  (Y) -->
<xacro:property name="th" value="0.05"/>   <!-- track height (Z) -->

<!-- Body Dimensions -->
<xacro:property name="bl" value="0.60"/>   <!-- body length (X) -->
<xacro:property name="bw" value="0.30"/>   <!-- body width  (Y) -->
<xacro:property name="bh" value="0.20"/>   <!-- body height (Z) -->

<!-- LiDAR Dimensions -->
<xacro:property name="lr" value="0.15"/> <!-- LiDAR Radius -->
<xacro:property name="ll" value="0.1"/>  <!-- LiDAR Length -->

<!-- ################################################    -->
<!--            Location Setup                           -->
<!--            MARK: LOCO                               -->
<!-- ################################################    -->

<!-- Arm / pivot geometry -->
<xacro:property name="pivot_margin" value="0.02"/>  <!-- keep pivot inside body end -->
<xacro:property name="xp" value="0.10"/>            <!-- track COM -> pivot along +X -->

<!-- Pivot locations on the body (X axis) -->
<xacro:property name="pivot_x_front" value="${ bl/2 - pivot_margin }"/>
<xacro:property name="pivot_x_rear"  value="${-(bl/2 - pivot_margin)}"/>

<!-- Track COM X positions (because track link origin is COM) -->
<xacro:property name="track_com_x_front" value="${ pivot_x_front - xp }"/>
<xacro:property name="track_com_x_rear"  value="${ pivot_x_rear  - xp }"/>

<!-- Left/right track COM Y placement -->
<xacro:property name="track_com_y" value="${ bw/2 + tw/2 }"/>

<!-- Body Z placement above ground (simple + stable version) -->
<xacro:property name="body_z_from_ground" value="${ th/2 + bh/2 }"/>

<!-- ################################################    -->
<!--                  Mass & Inertia                     -->
<!--                  MARK: M & I                        -->
<!-- ################################################    -->

<!-- Densities -->
<xacro:property name="body_density" value="2710.0"/>  <!-- body -->
<xacro:property name="track_density" value="2710.0"/>  <!-- track -->\

 <!-- LiDAR density is not set as it would affect the spin of
 the LiDAR if we were to set it. That being said the spin is
 not simulated so we do not need to worry about it.-->

<!-- Masses -->
<xacro:property name="body_mass" value="${body_density*bl*bh*bw}"/>
<xacro:property name="track_mass" value="${track_density*tl*th*tw}"/>

<!-- Body inertia -->
<xacro:property name="Ix_body" value="${(1.0/12.0)*body_mass*(bh*bh + bw*bw)}"/>
<xacro:property name="Iy_body" value="${(1.0/12.0)*body_mass*(bl*bl + bh*bh)}"/>
<xacro:property name="Iz_body" value="${(1.0/12.0)*body_mass*(bl*bl + bw*bw)}"/>

<!-- Track inertia -->
<xacro:property name="Ix_track" value="${(1.0/12.0)*track_mass*(tw*tw + th*th)}"/>
<xacro:property name="Iy_track" value="${(1.0/12.0)*track_mass*(tl*tl + th*th)}"/>
<xacro:property name="Iz_track" value="${(1.0/12.0)*track_mass*(tl*tl + tw*tw)}"/>

<!-- Inertia macros -->
<xacro:macro name="inertia_body">
    <inertial>
        <mass value="${body_mass}"/>
        <inertia ixx="${Ix_body}" ixy="0" ixz="0" iyy="${Iy_body}" iyz="0" izz="${Iz_body}"/>
    </inertial>
</xacro:macro>

<xacro:macro name="inertia_track">
    <inertial>
        <mass value="${track_mass}"/>
        <inertia ixx="${Ix_track}" ixy="0" ixz="0" iyy="${Iy_track}" iyz="0" izz="${Iz_track}"/>
    </inertial>
</xacro:macro>

<!-- ################################################ -->
<!--            Include Additional Files              -->
<!--            MARK: File Incl.                      -->
<!-- ################################################ -->

<xacro:include filename="$(find ember_robot)/model/ember.gazebo"/>

<!-- ################################################ -->
<!-- MARK: LINKS, JOINTS HERE                        -->
<!-- ################################################ -->


<!-- ################################################ -->
<!-- START: Fictitious Link of the Robot              -->
<!-- ################################################ -->

<link name="base_footprint"/>

<joint name="body_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="body_link"/>
</joint>

<!-- ################################################ -->
<!-- END: Fictitious Link of the Robot                -->
<!-- ################################################ -->

<!-- ################################################ -->
<!-- START: Body Link of the Robot                    -->
<!-- ################################################ -->

<link name="body_link">
    <visual>
        <geometry>
            <box size="${bl} ${bh} ${bw}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${body_z_from_ground}"/>
    </visual>

    <collision>
        <geometry>
            <box size="${bl} ${bh} ${bw}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${body_z_from_ground}"/>
    </collision>

    <xacro:inertia_body/>
</link>

<!-- ################################################ -->
<!-- END: Body Link of the Robot                      -->
<!-- ################################################ -->

<!-- ################################################  -->
<!-- START: Front Left Track of the Robot + Joint      -->
<!-- ################################################  -->

<joint name="front_left_track_joint" type="continuous">
    <parent link="body_link"/>
    <child link="flt_link"/>
    <origin xyz="${pivot_x_front} ${track_com_y} ${tw}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="flt_link">
    <visual>
        <origin xyz="${-xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </visual>

    <collision>
        <origin xyz="${-xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </collision>

    <xacro:inertia_track/>
</link>

<!-- ################################################  -->
<!-- END: Front Left Track                             -->
<!-- ################################################  -->

<!-- ################################################  -->
<!-- START: Front Right Track of the Robot + Joint     -->
<!-- ################################################  -->

<joint name="front_right_track_joint" type="continuous">
    <parent link="body_link"/>
    <child link="frt_link"/>
    <origin xyz="${pivot_x_front} ${-track_com_y} ${tw}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="frt_link">
    <visual>
        <origin xyz="${-xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </visual>

    <collision>
        <origin xyz="${-xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </collision>

    <xacro:inertia_track/>
</link>

<!-- ################################################  -->
<!-- END: Front Right Track                            -->
<!-- ################################################  -->

<!-- ################################################  -->
<!-- START: Back Left Track of the Robot + Joint       -->
<!-- ################################################  -->

<joint name="back_left_track_joint" type="continuous">
    <parent link="body_link"/>
    <child link="blt_link"/>
    <origin xyz="${-pivot_x_front} ${track_com_y} ${tw}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="blt_link">
    <visual>
        <origin xyz="${xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </visual>

    <collision>
        <origin xyz="${xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </collision>

    <xacro:inertia_track/>
</link>

<!-- ################################################  -->
<!-- END: Back Left Track                              -->
<!-- ################################################  -->

<!-- ################################################  -->
<!-- START: Back Right Track of the Robot + Joint       -->
<!-- ################################################  -->

<joint name="back_right_track_joint" type="continuous">
    <parent link="body_link"/>
    <child link="brt_link"/>
    <origin xyz="${-pivot_x_front} ${-track_com_y} ${tw}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="brt_link">
    <visual>
        <origin xyz="${xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </visual>

    <collision>
        <origin xyz="${xp} 0 0" rpy="0 0 0"/>
        <geometry><box size="${tl} ${tw} ${th}"/></geometry>
    </collision>

    <xacro:inertia_track/>
</link>

<!-- ################################################  -->
<!-- END: Back Right Track                              -->
<!-- ################################################  -->

<!-- ################################################  -->
<!-- START: LiDAR                                       -->
<!-- ################################################  -->

<joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.5" rpy="0 0 0"/>
</joint>

<link name="lidar_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.1" length="0.1"/></geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.1" length="0.1"/></geometry>
    </collision>

    <!-- Minimal but valid inertia -->
    <inertial>
        <mass value="1e-6"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
</link>

<!-- ################################################  -->
<!-- END: LiDAR                                         -->
<!-- ################################################  -->

</robot>