<!-- Gazebo Specifics -->
<!-- ############################################## -->
<!-- GAZEBO ADDITIONAL DESCRIPTION OF EMBER-Bot     -->
<!-- Inspiration and initial beginnings
     reference: Aleksandar Haber       
     ############################################## 
     Note: This handles Gazebo-specific extras. 
        meaning friction, materials, plugins,
        sensors. In other words robot behavior.     -->
<!-- ############################################## -->

<robot name="ember_bot">

  <!-- ################################################ -->
  <!-- BASE FRICTION AND MATERIALS                      -->
  <!-- ################################################ -->

  <gazebo reference="body_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Tracks (as box “wheels”) -->
  <gazebo reference="flt_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="frt_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="blt_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="brt_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- LiDAR visual material -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ################################################ -->
  <!-- DIFF DRIVE CONTROLLER for EMBER-Bot              -->
  <!-- ################################################ -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

      <!-- Multiple joints per side (front+back) -->
      <left_joint>front_left_track_joint</left_joint>
      <left_joint>back_left_track_joint</left_joint>

      <right_joint>front_right_track_joint</right_joint>
      <right_joint>back_right_track_joint</right_joint>

      <!-- Kinematics (using your xacro props) -->
      <!-- track_com_y = bw/2 + tw/2  => separation = 2*track_com_y -->
      <wheel_separation>${2*track_com_y}</wheel_separation>

      <!-- Treat track “rolling radius” as half the track height (th/2) -->
      <wheel_diameter>${th}</wheel_diameter>

      <!-- Limits -->
      <max_linear_acceleration>10</max_linear_acceleration>
      <max_angular_acceleration>10</max_angular_acceleration>

      <!-- Commands / odom -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <!-- ################################################ -->
    <!-- Joint State Publisher System                     -->
    <!-- ################################################ -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>front_left_track_joint</joint_name>
      <joint_name>front_right_track_joint</joint_name>
      <joint_name>back_left_track_joint</joint_name>
      <joint_name>back_right_track_joint</joint_name>
    </plugin>

  </gazebo>

  <!-- ################################################ -->
  <!-- MARK: LiDAR Sensor                               -->
  <!-- ################################################ -->

  <!-- Enable Sensors Engine (Gazebo Sim) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- LIDAR sensor -->
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>

      <!-- Make sure your bridge/ROS side listens to this -->
      <topic>scan</topic>
      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>

      <always_on>1</always_on>
      <visualize>1</visualize>
    </sensor>
  </gazebo>

</robot>