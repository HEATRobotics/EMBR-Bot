<?xml version="1.0"?>
<!--                                                     -->
<!-- SOURCE: https://www.youtube.com/watch?v=wOa1m8hzrgQ -->
<!-- ################################################    -->
<!-- URDF DESCRIPTION OF THE DIFFERENTIAL DRIVE ROBOT    -->
<!-- Reference/Source Aleksandar Haber                   -->
<!-- Refer to licence for questions                      -->
<!-- ################################################    -->

<robot name="ember_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ################################################    -->
<!--            Geometry & Constants                     -->
<!--            MARK: G & C                              -->
<!-- ################################################    -->

<xacro:property name="pi_const" value="3.14159265"/>

<!-- Body Dimensions -->
<xacro:property name="a" value="1.0"/>
<xacro:property name="b" value="0.3"/>
<xacro:property name="c" value="0.6"/>

<!-- Wheel & Caster Dimensions -->
<xacro:property name="r" value="0.15"/> <!-- Radius -->
<xacro:property name="d" value="0.1"/>  <!-- Width -->

<!-- Distances Between Certain Centres -->
<xacro:property name="s1" value="${b/2 + r}"/>
<xacro:property name="s2" value="${r*2}"/>
<xacro:property name="s3" value="${r*2}"/>
<xacro:property name="s4" value="${c/2 + d/2}"/>

<!-- ################################################    -->
<!--                  Mass & Inertia                     -->
<!--                  MARK: M & I                        -->
<!-- ################################################    -->

<!-- Densities -->
<xacro:property name="d1" value="2710.0"/>  <!-- body -->
<xacro:property name="d2" value="2710.0"/>  <!-- wheel -->
<xacro:property name="d3" value="2710.0"/>  <!-- caster -->

<!-- Masses -->
<xacro:property name="m1" value="${d1*a*b*c}"/>
<xacro:property name="m2" value="${d2*pi_const*r*r*d}"/>
<xacro:property name="m3" value="${d3*(4.0/3.0)*pi_const*r*r*r}"/>

<!-- Body inertia -->
<xacro:property name="Ix_body" value="${(1.0/12.0)*m1*(b*b + c*c)}"/>
<xacro:property name="Iy_body" value="${(1.0/12.0)*m1*(a*a + b*b)}"/>
<xacro:property name="Iz_body" value="${(1.0/12.0)*m1*(a*a + c*c)}"/>

<!-- Wheel inertia -->
<xacro:property name="Iz_wheel" value="${0.5*m2*r*r}"/>
<xacro:property name="I_wheel" value="${(1.0/12.0)*m2*(3.0*r*r + d*d)}"/>

<!-- Caster inertia -->
<xacro:property name="I_caster" value="${(2.0/5.0)*m3*r*r}"/>

<!-- Inertia macros -->
<xacro:macro name="inertia_body">
    <inertial>
        <mass value="${m1}"/>
        <inertia ixx="${Ix_body}" ixy="0" ixz="0" iyy="${Iy_body}" iyz="0" izz="${Iz_body}"/>
    </inertial>
</xacro:macro>

<xacro:macro name="inertia_wheel">
    <inertial>
        <origin rpy="1.570795 0 0" xyz="0 0 0"/>
        <mass value="${m2}"/>
        <inertia ixx="${I_wheel}" ixy="0" ixz="0" iyy="${I_wheel}" iyz="0" izz="${Iz_wheel}"/>
    </inertial>
</xacro:macro>

<xacro:macro name="inertia_caster">
    <inertial>
        <mass value="${m3}"/>
        <inertia ixx="${I_caster}" ixy="0" ixz="0" iyy="${I_caster}" iyz="0" izz="${I_caster}"/>
    </inertial>
</xacro:macro>

<!-- ################################################ -->
<!--            Include Additional Files              -->
<!--            MARK: File Incl.                      -->
<!-- ################################################ -->

<xacro:include filename="$(find ember_robot)/model/robot.gazebo"/>

<!-- ################################################ -->
<!-- MARK: LINKS, JOINTS HERE                        -->
<!-- ################################################ -->


<!-- ################################################ -->
<!-- START: Fictitious Link of the Robot              -->
<!-- ################################################ -->

<link name="base_footprint"/>

<joint name="body_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="body_link"/>
</joint>

<!-- ################################################ -->
<!-- END: Fictitious Link of the Robot                -->
<!-- ################################################ -->


<!-- ################################################ -->
<!-- START: Body Link of the Robot                    -->
<!-- ################################################ -->

<link name="body_link">
    <visual>
        <geometry>
            <box size="${a} ${c} ${b}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${s1}"/>
    </visual>

    <collision>
        <geometry>
            <box size="${a} ${c} ${b}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${s1}"/>
    </collision>

    <xacro:inertia_body/>
</link>

<!-- ################################################ -->
<!-- END: Body Link of the Robot                      -->
<!-- ################################################ -->


<!-- ################################################  -->
<!-- START: Back Right Wheel of the Robot + Joint      -->
<!-- ################################################  -->

<joint name="wheel1_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel1_link"/>
    <origin xyz="${-s2} ${-s4} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="wheel1_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>

    <xacro:inertia_wheel/>
</link>

<!-- ################################################  -->
<!-- END: Back Right Wheel                             -->
<!-- ################################################  -->


<!-- ################################################  -->
<!-- START: Back Left Wheel of the Robot + Joint       -->
<!-- ################################################  -->

<joint name="wheel2_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel2_link"/>
    <origin xyz="${-s2} ${s4} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
</joint>

<link name="wheel2_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>

    <xacro:inertia_wheel/>
</link>

<!-- ################################################  -->
<!-- END: Back Left Wheel                              -->
<!-- ################################################  -->


<!-- ################################################  -->
<!-- START: Caster Wheel                                -->
<!-- ################################################  -->

<joint name="caster_joint" type="fixed">
    <parent link="body_link"/>
    <child link="caster_link"/>
    <origin xyz="${s3} 0 ${r}" rpy="0 0 0"/>
</joint>

<link name="caster_link">
    <visual>
        <geometry><sphere radius="${r}"/></geometry>
    </visual>

    <collision>
        <geometry><sphere radius="${r}"/></geometry>
    </collision>

    <xacro:inertia_caster/>
</link>

<!-- ################################################  -->
<!-- END: Caster Wheel                                  -->
<!-- ################################################  -->


<!-- ################################################  -->
<!-- START: LiDAR                                       -->
<!-- ################################################  -->

<joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0" rpy="0 0 0"/>
</joint>

<link name="lidar_link">
    <visual>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <geometry><cylinder radius="0.1" length="0.1"/></geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <geometry><cylinder radius="0.1" length="0.1"/></geometry>
    </collision>

    <!-- Minimal but valid inertia -->
    <inertial>
        <mass value="1e-6"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
</link>

<!-- ################################################  -->
<!-- END: LiDAR                                         -->
<!-- ################################################  -->

</robot>