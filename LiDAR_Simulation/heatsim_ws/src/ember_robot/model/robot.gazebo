<?xml version="1.0"?>
<!-- This is the Robots URDF (Unified Robot Description Format) File For EMBER-Bot -->
<!-- ############################################## -->
<!-- GAZEBO ADDITIONAL DESCRIPTION OF EMBER-Bot     -->
<!-- Inspiration and initial beginnings
     reference: Aleksandar Haber                     -->
<!-- ############################################## -->

<robot name="ember_bot">

  <!-- ################################################ -->
  <!-- BASE FRICTION AND MATERIALS                     -->
  <!-- ################################################ -->

  <!-- NOTE:
       These reference= names MUST match the URDF link names.
       In your xacro: body, trackL1, trackL2, trackR1, trackR2, LiDAR
  -->

  <gazebo reference="body">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Tracks: slightly higher friction to “grip” -->
  <gazebo reference="trackL1">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="trackL2">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="trackR1">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="trackR2">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="LiDAR">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ################################################ -->
  <!-- DIFF DRIVE CONTROLLER for EMBER-Bot             -->
  <!-- ################################################ -->
  <!-- IMPORTANT:
       gz-sim-diff-drive-system expects ONE left_joint and ONE right_joint.
       Your robot has 2 track joints per side.
       So we “drive” the front tracks and lock the rear tracks to mimic same motion.
       If you want perfect sync, create mimic joints in URDF or switch to ros2_control.
  -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

      <!-- wheel joints (fixed names!) -->
      <left_joint>joint_trackL1</left_joint>
      <right_joint>joint_trackR1</right_joint>

      <!-- Kinematics -->
      <!-- Approx wheel separation: distance between left and right track centers.
           In our xacro we used: track_y_off = (bw/2 + tw/2)
           separation = 2*track_y_off = bw + tw
      -->
      <wheel_separation>${bw + tw}</wheel_separation>

      <!-- Approx wheel diameter: use track height as “effective diameter”
           (pure hack because tracks are boxes). If you later switch to real track model,
           replace with actual wheel diameter.
      -->
      <wheel_diameter>${2*th}</wheel_diameter>

      <!-- Limits -->
      <max_linear_acceleration>10</max_linear_acceleration>

      <!-- Topics, frames, odom -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publisher_frequency>30</odom_publisher_frequency>

    </plugin>

    <!-- ################################################ -->
    <!-- Joint State Publisher System                     -->
    <!-- ################################################ -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>

      <joint_name>joint_trackL1</joint_name>
      <joint_name>joint_trackL2</joint_name>
      <joint_name>joint_trackR1</joint_name>
      <joint_name>joint_trackR2</joint_name>
    </plugin>

    <!-- ################################################ -->
    <!-- MARK: Rear Track Sync (cheap “lock together”)    -->
    <!-- ################################################ -->
    <!-- This keeps back tracks “trying” to match the front tracks.
         It’s not a true mimic constraint, but it helps.
         Tune PIDs based on stability.
    -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <!-- Left rear follows left front -->
      <joint_name>joint_trackL2</joint_name>
      <position_target>0</position_target>
      <use_force_commands>true</use_force_commands>

      <!-- Right rear follows right front -->
      <joint_name>joint_trackR2</joint_name>
      <position_target>0</position_target>
      <use_force_commands>true</use_force_commands>
    </plugin>

  </gazebo>

  <!-- ################################################ -->
  <!-- MARK: LiDAR Sensor                               -->
  <!-- ################################################ -->

  <!-- Enable Sensors Engine (Ignition/Gazebo Sim) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- LIDAR sensor -->
  <gazebo reference="LiDAR">

    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose relative_to="LiDAR">0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.005</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>

      <always_on>1</always_on>
      <visualize>1</visualize>
    </sensor>

  </gazebo>

</robot>