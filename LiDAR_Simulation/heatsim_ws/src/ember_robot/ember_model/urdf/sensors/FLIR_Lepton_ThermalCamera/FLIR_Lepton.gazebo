<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="FLIR_Lepton_gazebo">

  <!-- Gazebo thermal sensor attachment macro -->
  <xacro:macro name="FLIR_thermal_gazebo" params="topic:=thermal_camera_8bit/image update_rate:=30 visualize:=true">
    <gazebo reference="thermal_camera">
      <sensor name="thermal_camera_8bit" type="thermal">
        <camera>
          <!-- Radians -> Deg -->
          <!-- Check Thermal Script -->
          <horizontal_fov>0.89</horizontal_fov>
          <image>
            <width>80</width>
            <height>60</height>
            <format>L8</format>
          </image>
          <!-- Allowances for camera viewing distance in metres.-->
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>

        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>${visualize}</visualize>
        <topic>${topic}</topic>

        <plugin
          filename="ignition-gazebo-thermal-sensor-system"
          name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>673.15</max_temp>
          <resolution>3.0</resolution>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>