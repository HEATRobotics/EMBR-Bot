<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="imu_sensor" params="parent_link imu_name topic update_rate">
    <gazebo reference="${parent_link}">
        <sensor name="${imu_name}" type="imu">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <topic>${topic}</topic>
        </sensor>
    </gazebo>
    </xacro:macro>
</robot>