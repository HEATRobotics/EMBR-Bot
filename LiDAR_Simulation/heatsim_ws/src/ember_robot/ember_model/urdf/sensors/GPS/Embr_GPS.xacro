<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gps_sensor" params="parent_link gps_name topic update_rate">
    <gazebo reference="${parent_link}">
        <sensor name="gps_sensor" type="navsat">
            <always_on>1</always_on>
            <update_rate>${update_rate}</update_rate>
            <visualize>true</visualize>
            <topic>${topic}</topic>
            <navsat>
            <position_sensing>
                <horizontal>
                <noise type="gaussian">
                    <mean>0.0</mean>
                    <stddev>0.1</stddev> <!-- Add some noise for realism -->
                </noise>
                </horizontal>
                <vertical>
                <noise type="gaussian">
                    <mean>0.0</mean>
                    <stddev>0.1</stddev>
                </noise>
                </vertical>
            </position_sensing>
            </navsat>
        </sensor>
    </gazebo>
    </xacro:macro>
</robot>