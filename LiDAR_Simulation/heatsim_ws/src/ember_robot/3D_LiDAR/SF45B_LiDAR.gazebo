<!-- Gazebo Specifics -->
<!-- ############################################## -->
<!-- GAZEBO ADDITIONAL DESCRIPTION OF EMBER-Bot     -->
<!-- Inspiration and initial beginnings
    reference: Aleksandar Haber       
    ############################################## 
    Note: This handles Gazebo-specific extras. 
    meaning friction, materials, plugins,
    sensors. In other words robot behavior.     -->
<!-- ############################################## -->

<!-- Gazebo specifics for EMBER-Bot LiDAR (URDF <gazebo> extensions) -->

<!-- LiDAR visual material -->
<gazebo reference="lidar_link">
  <material>Gazebo/Blue</material>
</gazebo>

<!-- If your WORLD already has the Sensors system plugin, you do NOT need this.
     If you don't have it in the world, keep it here. -->
<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
</gazebo>

<!-- GPU LiDAR sensor -->
<gazebo reference="lidar_link">
  <sensor name="gpu_lidar" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>

    <!-- This becomes the sensor topic base name in Gazebo -->
    <topic>scan</topic>
    <update_rate>10</update_rate>

    <lidar>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle> 3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.05</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>

      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.001</stddev>
      </noise>
    </lidar>

    <always_on>1</always_on>
    <visualize>1</visualize>
  </sensor>
</gazebo>