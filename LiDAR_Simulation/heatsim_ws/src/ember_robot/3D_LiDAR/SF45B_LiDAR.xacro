<?xml version="1.0"?>
<robot name="SF45B_lidar">
  <!-- BASE LINK (Cylindar) -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.029335" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.001087473" ixy="0" ixz="0"
               iyy="0.001087473" iyz="0"
               izz="0.001092437"/>
    </inertial>

    <collision name="base_collision">
      <origin xyz="0 0 0.029335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04267" length="0.05867"/>
      </geometry>
    </collision>

    <visual name="base_visual">
      <origin xyz="0 0 0.029335" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04267" length="0.05867"/>
      </geometry>
      <material name="Blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
  </link>

  <!-- TOP LINK (Cylindar) -->
  <!-- Enable Sensors Engine (Ignition/Gazebo Sim) -->
  <link name="top">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000090623" ixy="0" ixz="0"
               iyy="0.000090623" iyz="0"
               izz="0.000091036"/>
    </inertial>

    <collision name="top_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04267" length="0.05867"/>
      </geometry>
    </collision>

    <visual name="top_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04267" length="0.05867"/>
      </geometry>
      <material name="DarkGray">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
  </link>

  <!-- REVOLUTE JOINT (Continuous Spin) -->
  <joint name="joint" type="continuous">
    <origin xyz="0 0 0.088005" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="top"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="6.28"/>
  </joint>

  <!-- Gazebo Sim GPU LiDAR Sensor (attached to "top") -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
  <gazebo reference="top">
    <sensor name="gpu_lidar_sensor" type="gpu_lidar">
      <pose relative_to="top">0 0 0 0 0 0</pose>

      <visualize>1</visualize>
      <always_on>1</always_on>
      <update_rate>10</update_rate>

      <!-- gz transport topic -->
      <topic>scan</topic>

      <lidar>
        <scan>
          <horizontal>
            <!-- 360 deg sweep -->
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle> 3.14159265359</max_angle>
          </horizontal>

          <vertical>
            <!-- 32 channels (HDL-32-ish), using YOUR vertical FOV numbers -->
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.53529248</min_angle>
            <max_angle> 0.18622663</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.05</min>
          <max>70</max>
          <resolution>0.02</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>